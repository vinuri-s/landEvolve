# Python bytecode caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
qt_env/
venv/
env/
ENV/

# Project outputs you mentioned
resources/outputs/

# Mypy cache
.mypy_cache/

# IDE/editor
.vscode/
.idea/

# Common extras
.DS_Store
.pytest_cache/

# DEM rasters: ignored by default, but the input DEMs under resources/inputs
# are committed for reproducibility. Keep individual files under GitHub's
# 100 MB limit (use Git LFS or an external source for anything larger).
*.tif
!resources/inputs/**/*.tif

# The SQLite DB is generated fresh at first launch (main.py calls
# db_manager.create_tables() + seed_database(), seeded from app/data/seed.py)
# instead of being committed as a binary -- that binary previously drifted
# out of sync with seed.py whenever the app was used locally (e.g. editing
# vegetation classes writes straight back to this file), with no way to spot
# the change in review beyond an opaque binary diff.
app/data/db/*.db
app/data/db/*.db-shm
app/data/db/*.db-wal

dist/
build/
logs/*.log
